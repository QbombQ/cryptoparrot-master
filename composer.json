{
    "name": "laravel/laravel",
    "description": "The Laravel Framework.",
    "keywords": [
        "framework",
        "laravel"
    ],
    "license": "MIT",
    "type": "project",
    "require": {
        "php": "^7.1.3",
        "bitwasp/bech32": "^0.0.1",
        "buzz/laravel-google-captcha": "^2.1",
        "coinpaprika/coinpaprika-api-php-client": "^1.1",
        "cviebrock/eloquent-sluggable": "^6.0",
        "doctrine/dbal": "^2.7",
        "dongm2ez/larvel-mention": "^1.0",
        "duzun/hquery": "^2.1",
        "felixkiss/uniquewith-validator": "^3.1",
        "fideloper/proxy": "^4.0",
        "guzzlehttp/guzzle": "~6.0",
        "intervention/image": "^2.4",
        "kawankoding/laravel-fcm": "^0.1.6",
        "laravel/framework": "^6.9",
        "laravel/helpers": "^1.1",
        "laravel/slack-notification-channel": "^2.0",
        "laravel/socialite": "^4.0",
        "laravel/tinker": "^1.0",
        "laravolt/avatar": "^3.0",
        "merujan99/laravel-video-embed": "dev-master",
        "morrislaptop/laravel-queue-clear": "~1.0",
        "predis/predis": "^1.1",
        "pusher/pusher-php-server": "~3.0",
        "socialiteproviders/bitly": "^3.0",
        "socialiteproviders/discord": "^2.0",
        "socialiteproviders/generators": "^4.2",
        "socialiteproviders/reddit": "^3.0",
        "spatie/laravel-paginateroute": "^2.6",
        "torann/geoip": "^1.0"
    },
    "require-dev": {
        "filp/whoops": "^2.0",
        "fzaninotto/faker": "^1.4",
        "mockery/mockery": "^1.0",
        "nunomaduro/collision": "^2.0",
        "staudenmeir/dusk-updater": "^1.0" 
    },  
    "autoload": {
        "classmap": [
            "database/seeds",
            "database/factories"
        ],
        "psr-4": {
            "App\\": "app/",
            "SocialiteProviders\\Steemit\\": "SocialiteProviders/Steemit/src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "scripts": {
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover"
        ]
    },
    "config": {
        "preferred-install": "dist",
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
